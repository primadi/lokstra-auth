{
  "id": "non-existent-tenant-id",
  "name": "Ghost Tenant"
}

### 19. Error Test - Delete Non-existent Tenant
DELETE {{baseUrl}}{{pathPrefix}}/tenants/non-existent-tenant-id

### 20. Error Test - Get Non-existent Tenant
GET {{baseUrl}}{{pathPrefix}}/tenants/non-existent-tenant-id
